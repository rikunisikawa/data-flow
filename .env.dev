# Development environment variables for dbt (Athena)
# This file is intended to be tracked and used as a default for dev.
# For local overrides, create `.env` at the repo root or set ENV_FILE.

# Workspace bucket name: "<workspace>-<base_bucket_name>"
# See terraform/main.tf and terraform/*tfvars
BUCKET="dev-aws-data-platform-20250607"

# Athena query results / dbt materializations
S3_STAGING_DIR="s3://${BUCKET}/athena/staging/"
S3_DATA_DIR="s3://${BUCKET}/processed/"

# AWS / Glue / dbt settings
AWS_REGION="ap-northeast-1"
# Glue DB for source (stage)
GLUE_STAGE_DATABASE="dev_stage_mhealth"
# Glue DB for dbt models (target schema)
DBT_SCHEMA="dev_processed"
ATHENA_WORK_GROUP="primary"

# Notes:
# - For production, use BUCKET "prod-aws-data-platform-20250607"
#   and GLUE_DATABASE "prod_stage_mhealth" (do not commit secrets).
